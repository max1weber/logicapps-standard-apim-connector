  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Workflows.WebJobs.Extension" Version="1.170.91" />
    <ProjectReference Include="../Connector.Features/Connector.Features.csproj" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="IncludeFeatureAssembly" DependsOnTargets="ResolveReferences">
    <ItemGroup><BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" /></ItemGroup>
  </Target>
</Project>
